#!/usr/bin/env bash

set -euo pipefail

if (( EUID != 0 )); then
    SUDO="sudo"
else
    SUDO=""
fi

echo "=================================="
echo " Fedora Post Install"
echo "=================================="

# --------------------------------------------------
# Set Battery Limit
# --------------------------------------------------

echo "=========================================================="
echo " Configuring battery charge limits. "
echo "=========================================================="

HWDB_FILE="/etc/udev/hwdb.d/61-battery-local.hwdb"
BATTERY=$(find /sys/class/power_supply -maxdepth 1 -type l -name 'BAT*' -printf '%f\n' | head -n1)

if [[ -z "$BATTERY" ]]; then
    echo "No battery found. Skipping battery setup."
else
    echo "Battery detected: $BATTERY"
    echo "Setting charge limit to 50%-55%..."

    $SUDO mkdir -p /etc/udev/hwdb.d

    $SUDO tee "$HWDB_FILE" >/dev/null <<'EOF'
# To add local overrides, create a new file
# /etc/udev/hwdb.d/61-battery-local.hwdb
# and add your rules there. To load the new rules execute (as root):
# systemd-hwdb update
# udevadm trigger -v -p /sys/class/power_supply/BAT
# where BAT is the battery in question.
#
# CHARGE_LIMIT is in tuple format and each of the variables can be disabled by "_" character.
# For example:
# CHARGE_LIMIT=60,80 (charge_control_start_threshold is 60 and charge_control_end_threshold is 80.)
# CHARGE_LIMIT=_,80 (charge_control_start_threshold will be skipped and charge_control_end_threshold is 80.)

battery:*:*:dmi:*
 CHARGE_LIMIT=50,55
EOF

    if $SUDO systemd-hwdb update; then
        echo "systemd-hwdb updated."

        if $SUDO udevadm trigger -v "/sys/class/power_supply/$BATTERY"; then
            echo "udevadm triggered successfully."
            echo
            echo "Battery charge limit setup completed."
            echo
        else
            echo "Warning: udevadm trigger failed. Continuing..."
        fi
    else
        echo "Warning: systemd-hwdb update failed. Skipping battery setup."
    fi


    if [[ -f "/sys/class/power_supply/$BATTERY/charge_control_start_threshold" ]]; then
        echo "Start threshold:"
        cat "/sys/class/power_supply/$BATTERY/charge_control_start_threshold"
    fi

    if [[ -f "/sys/class/power_supply/$BATTERY/charge_control_end_threshold" ]]; then
        echo "End threshold:"
        cat "/sys/class/power_supply/$BATTERY/charge_control_end_threshold"
    fi
fi

# --------------------------------------------------
# Configure DNF
# --------------------------------------------------

DNF_CONF="/etc/dnf/dnf.conf"

set_dnf_option() {
    local key="$1"
    local value="$2"

    if grep -q "^${key}=" "$DNF_CONF"; then
        $SUDO sed -i "s/^${key}=.*/${key}=${value}/" "$DNF_CONF"
    else
        echo "${key}=${value}" | $SUDO tee -a "$DNF_CONF" >/dev/null
    fi
}

set_excludepkgs() {
    local state="$1"

    if grep -Eq '^#?excludepkgs=' "$DNF_CONF"; then
        if [[ "$state" == "comment" ]]; then
            $SUDO sed -Ei 's/^excludepkgs=/#excludepkgs=/' "$DNF_CONF"
        else
            $SUDO sed -Ei 's/^#excludepkgs=/excludepkgs=/' "$DNF_CONF"
        fi
    else
        if [[ "$state" == "comment" ]]; then
            echo "#excludepkgs=libreoffice*,firefox*" | $SUDO tee -a "$DNF_CONF" >/dev/null
        else
            echo "excludepkgs=libreoffice*,firefox*" | $SUDO tee -a "$DNF_CONF" >/dev/null
        fi
    fi
}

echo "[1/5] Configuring DNF..."

set_dnf_option max_parallel_downloads 10
set_dnf_option fastestmirror true
set_dnf_option defaultyes true
set_dnf_option keepcache true

echo
echo "Configure excludepkgs?"
echo
echo "[Y] Disable excludepkgs (recommended)"
echo "[n] Enable excludepkgs"
echo

reply=""

for ((i=10; i>0; i--)); do
    echo -ne "\rProceed? [Y/n] (auto-yes in ${i}s): "

    if [[ -t 0 ]]; then
        if read -r -t 1 reply; then
            break
        fi
    else
        if read -r -t 1 reply </dev/tty; then
            break
        fi
    fi
done

echo

case "${reply,,}" in
    ""|y|yes)
        set_excludepkgs comment
        echo "excludepkgs is commented."
        ;;
    n|no)
        set_excludepkgs uncomment
        echo "excludepkgs is enabled."
        ;;
    *)
        echo "Invalid input. Using default."
        set_excludepkgs comment
        echo "excludepkgs is commented."
        ;;
esac

# --------------------------------------------------
# Enable RPM Fusion
# --------------------------------------------------

echo "[2/5] Enabling RPM Fusion and flathub repo..."

if ! command -v flatpak >/dev/null 2>&1; then
    echo "Flatpak not found. Installing..."
    $SUDO dnf install -y flatpak
fi

$SUDO flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo

echo "Flathub repository configured."
echo
echo "flathub.flatpakrepo added."
echo

FEDORA_VERSION="$(rpm -E %fedora)"

$SUDO dnf install -y \
"https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-${FEDORA_VERSION}.noarch.rpm" \
"https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-${FEDORA_VERSION}.noarch.rpm"


# --------------------------------------------------
# Firmware
# --------------------------------------------------

echo "[3/5] Refreshing firmware metadata..."

fwupdmgr refresh --force || true
fwupdmgr get-updates || true

echo "To install available firmware updates, run: "
echo "fwupdmgr update"

# --------------------------------------------------
# System Update
# --------------------------------------------------

echo "[4/5] Updating system..."

$SUDO dnf upgrade -y --refresh

# --------------------------------------------------
# Multimedia
# --------------------------------------------------

echo "[5/5] Installing multimedia codecs..."

$SUDO dnf swap -y ffmpeg-free ffmpeg --allowerasing



echo
echo "=================================="
echo " Fedora post-install setup completed!"
echo "=================================="
echo
echo "A reboot is recommended to apply all updates."
echo

echo

if [[ -t 0 ]]; then
    read -rp "Reboot now? [y/N]: " answer
else
    read -rp "Reboot now? [y/N]: " answer </dev/tty
fi

case "${answer,,}" in
    y|yes)
        echo "Rebooting..."
        $SUDO reboot
        ;;
    *)
        echo "Please reboot your system later to apply all changes."
        ;;
esac
