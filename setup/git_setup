#!/usr/bin/env bash

set -euo pipefail

echo "=================================="
echo " Git & SSH Setup"
echo "=================================="

# --------------------------------------------------
# Sudo
# --------------------------------------------------

if (( EUID != 0 )); then
    SUDO="sudo"
else
    SUDO=""
fi

# --------------------------------------------------
# Check / Install Git
# --------------------------------------------------

echo
echo "Checking Git..."

if ! command -v git >/dev/null 2>&1; then
    echo "Git is not installed."
    echo "Installing Git..."

    $SUDO dnf install -y git

    echo "✓ Git installed."
else
    echo "✓ Git is already installed."
fi

# --------------------------------------------------
# Check / Install Micro
# --------------------------------------------------

echo
echo "Checking Micro..."

if ! command -v micro >/dev/null 2>&1; then
    echo "Micro is not installed."
    echo "Installing Micro..."

    $SUDO dnf install -y micro

    echo "✓ Micro installed."
else
    echo "✓ Micro is already installed."
fi


# --------------------------------------------------
# Git configuration
# --------------------------------------------------

GIT_CONFIG="$HOME/.gitconfig"

if [[ -f "$GIT_CONFIG" ]]; then
    TIMESTAMP=$(date '+%Y-%m-%d---%H-%M-%S')
    BACKUP="${GIT_CONFIG}.bak-${TIMESTAMP}"

    echo
    echo "Existing Git config found."
    echo "Creating backup..."

    cp "$GIT_CONFIG" "$BACKUP"
    rm -f "$GIT_CONFIG"

    echo "✓ Backup created:"
    echo "  $BACKUP"
    echo "✓ Existing Git config removed."
    echo "✓ Creating fresh Git configuration..."
fi

DEFAULT_NAME="ImtiazAR"
DEFAULT_EMAIL="169064290+imtiazAR@users.noreply.github.com"

echo
echo "=================================="
echo " Configure Git"
echo "=================================="
echo


git config --global user.name "$DEFAULT_NAME"
git config --global user.email "$DEFAULT_EMAIL"

git config --global init.defaultBranch main
git config --global color.ui auto
git config --global merge.conflictstyle zdiff3
git config --global core.editor micro
git config --global pull.rebase false

git config --global alias.st status
git config --global alias.br branch
git config --global alias.co checkout
git config --global alias.cm "commit -m"
git config --global alias.lg "log --graph --oneline --decorate --all"

echo
echo "✓ Git configured."

# --------------------------------------------------
# SSH key
# --------------------------------------------------

KEY="$HOME/.ssh/id_ed25519"
PUB_KEY="${KEY}.pub"

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"

if [[ ! -f "$KEY" ]]; then
    echo
    echo "Generating SSH key..."

    ssh-keygen \
        -t ed25519 \
        -C "$DEFAULT_EMAIL" \
        -f "$KEY" \
        -N ""

    echo "✓ SSH key generated."

else
    echo
    echo "✓ Existing SSH key found."

  
# Regenerate public key if missing
 
   if [[ ! -f "$PUB_KEY" ]]; then
        echo "Public key is missing."
        echo "Regenerating public key from private key..."

        ssh-keygen -y -f "$KEY" > "$PUB_KEY"

        echo "✓ Public key regenerated."
    fi
fi

chmod 600 "$KEY"
chmod 644 "$PUB_KEY"

# --------------------------------------------------
# Show public key
# --------------------------------------------------

echo
echo "=================================="
echo " SSH Public Key"
echo "=================================="
echo

cat "$PUB_KEY"

echo

echo "Add this key to your Git hosting account."
echo
echo "GitHub:"
echo "  Settings → SSH and GPG keys → New SSH key"
echo
echo "GitLab:"
echo "  Preferences → SSH Keys → Add new key"
echo

# --------------------------------------------------
# Test commands
# --------------------------------------------------

echo "=================================="
echo " Setup Complete"
echo "=================================="

echo
echo "Git configuration:"
echo "  Name : $(git config --global user.name)"
echo "  Email: $(git config --global user.email)"

echo
echo "SSH key:"
echo "  $KEY"

echo
echo "Test GitHub SSH:"
echo "  ssh -T git@github.com"

echo
echo "Test GitLab SSH:"
echo "  ssh -T git@gitlab.com"

echo
echo "=================================="
echo " Git & SSH setup completed."
echo "=================================="

echo
echo "=================================="
echo " Summary "
echo "=================================="

echo
echo "=================================="
echo " Git Configuration"
echo "=================================="
echo

git config --global --list --show-origin

echo
echo "=================================="
echo " SSH Configuration"
echo "=================================="
echo

echo "Private key:"
echo "  $KEY"

echo
echo "Public key:"
echo "  $PUB_KEY"

echo
echo "Public key content:"
cat "$PUB_KEY"
