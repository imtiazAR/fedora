#!/usr/bin/env bash

set -euo pipefail

echo "=================================="
echo " Git & SSH Setup"
echo "=================================="

# --------------------------------------------------
# Sudo
# --------------------------------------------------

if (( EUID != 0 )); then
    SUDO="sudo"
else
    SUDO=""
fi

# --------------------------------------------------
# Check / Install Git
# --------------------------------------------------

echo
echo "Checking Git..."

if ! command -v git >/dev/null 2>&1; then
    echo "Git is not installed."
    echo "Installing Git..."

    $SUDO dnf install -y git

    echo "✓ Git installed."
else
    echo "✓ Git is already installed."
fi

# --------------------------------------------------
# Check / Install Micro
# --------------------------------------------------

echo
echo "Checking Micro..."

if ! command -v micro >/dev/null 2>&1; then
    echo "Micro is not installed."
    echo "Installing Micro..."

    $SUDO dnf install -y micro

    echo "✓ Micro installed."
else
    echo "✓ Micro is already installed."
fi

# --------------------------------------------------
# Prompt helper
# --------------------------------------------------

prompt_default() {
    local prompt="$1"
    local default="$2"
    local value

    read -r \
        -e \
        -i "$default" \
        -t 5 \
        -p "$prompt [$default]: " \
        value </dev/tty || true

    printf '%s\n' "${value:-$default}"
}

# --------------------------------------------------
# Git configuration
# --------------------------------------------------

DEFAULT_NAME="ImtiazAR"
DEFAULT_EMAIL="169064290+imtiazAR@users.noreply.github.com"

echo
echo "=================================="
echo " Configure Git"
echo "=================================="
echo
echo "Press Enter to keep the default."
echo "Automatically continues after 5 seconds."
echo

GIT_NAME=$(prompt_default "Git username" "$DEFAULT_NAME")
GIT_EMAIL=$(prompt_default "Git email" "$DEFAULT_EMAIL")

git config --global user.name "$GIT_NAME"
git config --global user.email "$GIT_EMAIL"

git config --global init.defaultBranch main
git config --global color.ui auto
git config --global merge.conflictstyle zdiff3
git config --global core.editor micro

echo
echo "✓ Git configured."

# --------------------------------------------------
# SSH key
# --------------------------------------------------

KEY="$HOME/.ssh/id_ed25519"

if [[ ! -f "$KEY" ]]; then
    echo
    echo "Generating SSH key..."

    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"

    ssh-keygen \
        -t ed25519 \
        -C "$GIT_EMAIL" \
        -f "$KEY" \
        -N ""

    echo "✓ SSH key generated."
else
    echo
    echo "✓ Existing SSH key found."
fi

# --------------------------------------------------
# SSH agent
# --------------------------------------------------

if ! pgrep -u "$USER" ssh-agent >/dev/null 2>&1; then
    eval "$(ssh-agent -s)" >/dev/null
fi

ssh-add "$KEY" >/dev/null 2>&1 || true

echo "✓ SSH key added to ssh-agent."

# --------------------------------------------------
# Show public key
# --------------------------------------------------

echo
echo "=================================="
echo " SSH Public Key"
echo "=================================="
echo

cat "${KEY}.pub"

echo

echo "Add this key to your Git hosting account."
echo
echo "GitHub:"
echo "  Settings → SSH and GPG keys → New SSH key"
echo
echo "GitLab:"
echo "  Preferences → SSH Keys → Add new key"
echo

# --------------------------------------------------
# Test commands
# --------------------------------------------------

echo "=================================="
echo " Setup Complete"
echo "=================================="

echo
echo "Git configuration:"
echo "  Name : $(git config --global user.name)"
echo "  Email: $(git config --global user.email)"

echo
echo "SSH key:"
echo "  $KEY"

echo
echo "Test GitHub SSH:"
echo "  ssh -T git@github.com"

echo
echo "Test GitLab SSH:"
echo "  ssh -T git@gitlab.com"

echo
echo "=================================="
echo " Git & SSH setup completed."
echo "=================================="
